#!/bin/sh
# Public repo: refuse to push if any commit contains a secret.
PATH="$HOME/Library/Application Support/Peeraxis Engine/bin:$HOME/.local/bin:$PATH"
command -v gitleaks >/dev/null 2>&1 || { echo "Push refused: the gitleaks secret scanner is not installed." >&2; exit 1; }
gitleaks git --redact --no-banner . || { echo "Push refused: gitleaks found a possible secret." >&2; exit 1; }
